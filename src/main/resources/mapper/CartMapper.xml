<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bzy.takeaway.mapper.CartMapper">

    <!-- 物理删除购物车记录（忽略软删除） -->
    <delete id="deletePhysical">
        DELETE FROM cart WHERE user_id = #{userId} AND store_id = #{storeId} AND dish_id = #{dishId}
    </delete>

</mapper>
